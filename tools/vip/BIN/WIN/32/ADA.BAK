include "ada.inc"

include "dfd.inc"

predicates

 nondeterm min(integer,integer,integer)

clauses
min(A,B,A):- A<=B,!.
min(_,B,B).
goal
write("A= "),readint(A),
write("B= "),readint(B),
min(A,B,Min),write("Minimum=",Min),nl .
