perem("N","Введите среднее количество землетрясений в сутки: ")
perem("G","Как ведут себя грозы у вулкана (участились/редко): ")
perem("Gas","Есть ли изменения в составе газов (да/нет): ")
perem("Izv","")
perem("D","")
goal_var("D")
rule(1,[lt("N","10"),eq("G","редко")],assign("Izv","извержение не угрожает"))
rule(2,[lt("N","10"),eq("G","участились")],assign("Izv","возможно извержение в течение ближайшего месяца"))
rule(3,[gt("N","15")],assign("Izv","извержение произойдет в ближайшие 5 дней"))
rule(4,[ge("N","10"),le("N","15"),eq("Gas","да")],assign("Izv","извержение может начаться в ближайшие 10 дней"))
rule(5,[ge("N","10"),le("N","15"),eq("Gas","нет")],assign("Izv","извержение может начаться в ближайшие 20 дней"))
rule(6,[eq("Izv","извержение может начаться в ближайшие 10 дней")],assign("D","необходима эвакуация"))
rule(7,[eq("Izv","извержение может начаться в ближайшие 20 дней")],assign("D","готовность к эвакуации"))
rule(8,[eq("Izv","возможно извержение в течение ближайшего месяца")],assign("D","усиленное наблюдение"))
rule(9,[eq("Izv","извержение не угрожает")],assign("D","никаких действий не требуется"))
rule(10,[eq("Izv","извержение произойдет в ближайшие 5 дней")],assign("D","немедленная эвакуация (максимальная угроза)"))
