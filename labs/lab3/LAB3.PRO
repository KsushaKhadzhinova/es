/* =====================================================================
   ЛАБОРАТОРНАЯ РАБОТА №3.  Вариант 5.
   Тема: развитые типы данных (функторы, альтернативные домены) и базы
   данных на Прологе.

   ЗАДАНИЕ (вариант 5): база данных предприятия:
     - контракты на поставку товаров:
         contr(Шифр, Покупатель, Товар, Оплата)
       где Оплата - альтернативный домен (см. п.3.1 методички):
         opl(Сумма)              - контракт оплачен полностью предоплатой
         predopl(Сумма1,Сумма2)  - Сумма1 оплачена предварительно,
                                    Сумма2 - после поставки
     - иностранные предприятия-покупатели:
         pokup(Предприятие, Страна, Город)

   Требуемые операции (программа с меню, см. п.3.8 методички):
     1 - загрузка базы данных из файла (consult)
     2 - просмотр списка контрактов на экране
     3 - добавление нового покупателя
     4 - сохранение базы данных в файл (save)
     99 - выход

   Файл базы данных по умолчанию: lab3.dba (лежит рядом с LAB3.PRO).
   Он уже содержит демонстрационные данные из задания.
   ===================================================================== */

global domains
    oplata = opl(integer);
             predopl(integer, integer)

global facts
    contr(string, string, string, oplata)
    pokup(string, string, string)

predicates
    nondeterm start
    nondeterm obrab(integer)

    nondeterm zagruzka
    nondeterm prosmotr_contr
    nondeterm pechat_kontrakt(string, string, string, oplata)
    nondeterm dobav_pokup
    nondeterm sohran
    nondeterm repeat

goal
    start.

clauses
    /* repeat - НЕ встроенный предикат этого диалекта Пролога, его нужно
       определить самим (методичка, п.1.6.2). */
    repeat.
    repeat:- repeat.

    /* ------------------------------ МЕНЮ --------------------------------
       Классическая схема из п.3.8 методички: repeat даёт возможность
       выполнять операции с базой данных многократно. Каждый клоз obrab,
       КРОМЕ клоза для выхода (99), заканчивается неудачей (fail) - тогда
       происходит откат к repeat, меню печатается заново. Клоз obrab(99)
       не проваливается - на нём цикл repeat успешно завершается. */
    start:-
        repeat,
        nl,
        write("======= База данных предприятия (лаб.3, вариант 5) ======="), nl,
        write("1 - загрузка базы данных"), nl,
        write("2 - просмотр списка контрактов"), nl,
        write("3 - добавление нового покупателя"), nl,
        write("4 - сохранение базы данных"), nl,
        write("99 - выход"), nl,
        write("Введите номер: "), readint(N),
        obrab(N).

    obrab(1):- zagruzka, !, fail.
    obrab(2):- prosmotr_contr, !, fail.
    obrab(3):- dobav_pokup, !, fail.
    obrab(4):- sohran, !, fail.
    obrab(99):- write("Выход из программы."), nl.
    obrab(_):- write("Нет такого пункта меню."), nl, fail.

    /* ---------------------- 1. ЗАГРУЗКА БД (п.3.3) -----------------------
       retractall(_) на первом шаге убирает из памяти ВСЕ факты, которые
       могли остаться от предыдущей загрузки (иначе при повторной
       загрузке факты бы задваивались). Второй клоз ловит случай, если
       пользователь нажал ESC при вводе имени файла (readln проваливается) -
       тогда просто ничего не делаем, но zagruzka всё равно "успешна". */
    zagruzka:-
        write("Введите имя файла базы данных (например, lab3.dba): "),
        readln(F),
        retractall(_),
        consult(F), !,
        write("База данных загружена: ", F), nl.
    zagruzka:-
        write("Загрузка отменена."), nl.

    /* ------------------- 2. ПРОСМОТР СПИСКА КОНТРАКТОВ -------------------
       Функтор Оплата - альтернативный домен (opl/predopl), поэтому его
       нужно РАЗБИРАТЬ по функтору, чтобы вывести сумму по-разному для
       каждого случая (см. п.3.1 методички - пример с oplata=rub/doll). */
    prosmotr_contr:-
        contr(Shifr, Pokupatel, Tovar, Oplata),
        pechat_kontrakt(Shifr, Pokupatel, Tovar, Oplata),
        fail.
    prosmotr_contr.

    pechat_kontrakt(Shifr, Pokupatel, Tovar, opl(Summa)):-
        !,
        write("Контракт ", Shifr, ": покупатель ", Pokupatel,
              ", товар ", Tovar, ", оплачен полностью (", Summa, ")"), nl.
    pechat_kontrakt(Shifr, Pokupatel, Tovar, predopl(S1, S2)):-
        write("Контракт ", Shifr, ": покупатель ", Pokupatel,
              ", товар ", Tovar,
              ", предоплата ", S1, ", доплата после поставки ", S2), nl.

    /* ------------------- 3. ДОБАВЛЕНИЕ НОВОГО ПОКУПАТЕЛЯ ------------------
       Используем стандартный предикат assert (см. п.3.5 методички) -
       он создаёт в памяти новый факт pokup. Обратите внимание: assert
       меняет базу данных только В ПАМЯТИ; чтобы изменения попали в файл
       на диске, нужно после этого выполнить операцию "4 - сохранение". */
    dobav_pokup:-
        write("Название предприятия-покупателя: "), readln(Predpr),
        write("Страна: "), readln(Strana),
        write("Город: "), readln(Gorod),
        assert(pokup(Predpr, Strana, Gorod)),
        write("Покупатель добавлен (пока только в памяти, не забудьте сохранить!)"), nl.

    /* ---------------------- 4. СОХРАНЕНИЕ БД (п.3.6) ---------------------- */
    sohran:-
        write("Введите имя файла для сохранения (например, lab3.dba): "),
        readln(F),
        save(F), !,
        write("База данных сохранена: ", F), nl.
    sohran:-
        write("Сохранение отменено."), nl.
