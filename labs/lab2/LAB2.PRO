/* =====================================================================
   ЛАБОРАТОРНАЯ РАБОТА №2.  Вариант 5.
   Тема: рекурсия и списки в программах на Прологе.

   ЗАДАНИЕ (вариант 5):
   1) Расщепить список на два: первый список - заданной длины N (первые
      N элементов исходного), второй - остаток. Например, для списка
      [1,5,7,3,4] и числа 2 должны получиться [1,5] и [7,3,4].
   2) Есть факты:
        raspol(Страна, СписокПредприятий)  - какие предприятия в стране
        postav(Поставщик, Покупатель, Товар, Сумма)
      Программа спрашивает страну и сумму. Печатает список ВСЕХ
      товаров, поставляемых каким-либо предприятием ЭТОЙ страны за
      границу, если сумма поставки >= указанной (с указанием
      предприятия-поставщика, предприятия-покупателя и страны-покупателя).

   Использованные приёмы (см. методичку, лаб.2):
     - домены-списки: domains  spisok_str = string*  /  spisok_int = integer*
       (ВАЖНО: в задании 1 расщепляется список ЧИСЕЛ, а в задании 2
       используется список НАЗВАНИЙ предприятий - это два РАЗНЫХ типа
       списков, поэтому и домена для них нужно два разных! Изначально
       тут была одна ошибка: оба домена были объявлены как string* -
       из-за этого readterm не мог прочитать список чисел [1,5,7,3,4]
       - компилятор и тестовый прогон эту ошибку поймали и она исправлена)
     - разбор списка на голову/хвост [H|T]
     - рекурсия по списку (podspisok-подобная схема расщепления)
     - предикат prinadl(X,L) - проверка принадлежности элемента списку
   ===================================================================== */

domains
    spisok_str = string*
    spisok_int = integer*

predicates
    nondeterm raspol(string, spisok_str)
    nondeterm postav(string, string, string, integer)

    nondeterm start
    nondeterm obrab_menu(integer)
    nondeterm zadanie1
    nondeterm zadanie2

    nondeterm rasshepit(spisok_int, integer, spisok_int, spisok_int)
    nondeterm prinadl(string, spisok_str)
    nondeterm naidi_stranu(string, string)
    nondeterm poisk2(string, integer)

goal
    start.

clauses
    /* ---------------- БАЗА ДАННЫХ (пример из методички, лаб.2) ---------- */
    raspol("Россия", ["Оптрон","Счетмаш","Кварц"]).
    raspol("Польша", ["Элтор"]).
    raspol("США",    ["IBM","Apple"]).

    postav("Элтор","Счетмаш","трансформатор",200).
    postav("Счетмаш","Оптрон","осциллограф",500).
    postav("Оптрон","IBM","диод",900).
    postav("Кварц","Apple","резистор",150).

    /* ---------------------------- МЕНЮ ----------------------------------
       Здесь без цикла "продолжить работу" (в задании варианта 5 такого
       требования нет, в отличие от лаб.1) - просто спросили номер задания,
       выполнили, и на этом программа заканчивает работу. Если хотите
       выполнить оба задания подряд - запустите программу дважды, либо
       (по желанию) добавьте repeat по образцу LAB1.PRO. */
    start:-
        write("=== Лабораторная работа 2, вариант 5 ==="), nl,
        write("1 - Задание 1 (расщепление списка)"), nl,
        write("2 - Задание 2 (страна, сумма -> экспортируемые товары)"), nl,
        write("Введите номер задания: "), readint(N),
        obrab_menu(N).

    obrab_menu(1):- zadanie1, !.
    obrab_menu(2):- zadanie2, !.
    obrab_menu(_):- write("Нет такого пункта меню"), nl.

    /* -------------------------- ЗАДАНИЕ 1 -------------------------------
       Расщепление списка на первые N элементов и остаток.
       Логика (аналогична podspisok из методички, п.2.4):
         - если N=0, то первая часть пустая, вторая = весь список;
         - если список пуст, а N>0 - значит, N больше длины списка;
           будем считать, что тогда первая часть = весь (пустой) список,
           вторая тоже пустая (защита от некорректного ввода);
         - иначе берём голову списка в первую часть и уменьшаем N на 1,
           рекурсивно обрабатывая хвост. */
    rasshepit(L, 0, [], L):- !.
    rasshepit([], _, [], []):- !.
    rasshepit([H|T], N, [H|Pervaya], Vtoraya):-
        N > 0,
        N1 = N - 1,
        rasshepit(T, N1, Pervaya, Vtoraya).

    zadanie1:-
        write("Введите список чисел, например [1,5,7,3,4]: "),
        readterm(spisok_int, Spisok),
        write("Введите длину первой части (N): "), readint(N),
        rasshepit(Spisok, N, Pervaya, Vtoraya),
        write("Первая часть: ", Pervaya), nl,
        write("Вторая часть: ", Vtoraya), nl.

    /* -------------------------- ЗАДАНИЕ 2 -------------------------------
       Обходим все предприятия страны (список СписокПредприятий у факта
       raspol), для каждого ищем поставки postav(Predpr,...) с суммой не
       менее указанной. Приём "вывести ВСЕ ответы" - через fail (п.1.6.1). */
    zadanie2:-
        write("Введите название страны: "), readln(Strana),
        write("Введите минимальную сумму: "), readint(Summa),
        poisk2(Strana, Summa).

    poisk2(Strana, Summa):-
        raspol(Strana, SpisokPredpr),
        postav(Postavshik, Pokupatel, Tovar, S),
        prinadl(Postavshik, SpisokPredpr),   /* поставщик - предприятие этой страны */
        S >= Summa,
        naidi_stranu(Pokupatel, StranaPok),
        write("Товар: ", Tovar,
              "   Поставщик: ", Postavshik,
              "   Покупатель: ", Pokupatel,
              "   Страна покупателя: ", StranaPok), nl,
        fail.
    poisk2(_,_).

    /* Проверка принадлежности элемента списку (см. методичку, п.2.3) */
    prinadl(X, L):- L = [X|_], !.
    prinadl(X, L):- L = [_|T], prinadl(X, T).

    /* По названию предприятия найти страну, обходя все факты raspol
       и проверяя принадлежность предприятия списку этой страны. */
    naidi_stranu(Predpr, Strana):-
        raspol(Strana, Spisok),
        prinadl(Predpr, Spisok), !.
