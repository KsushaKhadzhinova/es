/* =====================================================================
   ЛАБОРАТОРНАЯ РАБОТА №8.  Вариант 5.
   Тема: байесовская стратегия оценки выводов.

   ЗАДАНИЕ (вариант 5): медицинская ЭС выбора лекарства. Есть
   статистика по 300 больным (см. Es 7_8.docx, табл. к варианту 5):

     Симптом                      Состояние        Улучшение  Без улучшения
     Температура                  Свыше 40            38           57
                                   От 38 до 40         112          23
                                   От 37 до 38          42          28
     Боль                         Очень сильная        45           60
                                   Сильная             109          25
                                   Умеренная            38           23
     Откл. в составе крови        Есть                 62           48
                                   Нет                 130          60

   ПРИМЕЧАНИЕ: суммы по столбцам дают 192 "улучшение" и 108 "без
   улучшения" (итого 300), хотя в тексте задания написано "у 193
   наблюдалось улучшение" - это опечатка оригинала методических
   указаний (расхождение на 1). В расчёте используются точные суммы
   из таблицы (192/108), как более надёжные.

   Дано: температура 38,5 (=> группа "От 38 до 40"), боль "Сильная",
   отклонений в составе крови НЕТ.
   Найти: вероятность того, что лекарство приведёт к улучшению.

   ХОД РЕШЕНИЯ (формула Байеса, п.8.1-8.2 методички):
     H1 = "улучшение", H2 = "без улучшения"           - гипотезы
     E1,E2,E3 = наблюдаемые признаки (температура, боль, кровь) - свидетельство

     P(H1) = 192/300,  P(H2) = 108/300                - априорные вероятности

     P(E1/H1)=112/192, P(E2/H1)=109/192, P(E3/H1)=130/192
     P(E1/H2)=23/108,  P(E2/H2)=25/108,  P(E3/H2)=60/108

     P(E/Hi) = P(E1/Hi)*P(E2/Hi)*P(E3/Hi)     (события считаем независимыми,
                                                формула умножения вероятностей)

                     P(H1)*P(E/H1)
     P(H1/E) = ---------------------------------     (формула Байеса)
                P(H1)*P(E/H1) + P(H2)*P(E/H2)

   Программа считает всё это не "в лоб" одним выражением, а пошагово,
   печатая каждую промежуточную величину - именно так, как требуется
   расписывать решение в отчёте по лабораторной работе.
   ===================================================================== */

predicates
    nondeterm start

goal
    start.

clauses
    start:-
        write("=== Лаб.8, вариант 5: байесовская оценка эффективности лекарства ==="), nl, nl,

        /* -------- статистика из таблицы задания (см. заголовок файла) --- */
        Vsego = 300,
        N_uluchsh = 192,
        N_bez_uluchsh = 108,

        /* строка "От 38 до 40" (подходит под температуру 38,5) */
        E1_H1 = 112, E1_H2 = 23,
        /* строка "Сильная" (боль) */
        E2_H1 = 109, E2_H2 = 25,
        /* строка "Нет" (отклонений в крови нет) */
        E3_H1 = 130, E3_H2 = 60,

        /* ---------------- шаг 1: априорные вероятности ------------------ */
        P_H1 = N_uluchsh / Vsego,
        P_H2 = N_bez_uluchsh / Vsego,
        write("P(H1) = ", N_uluchsh, "/", Vsego, " = ", P_H1, "   (априорная вер. улучшения)"), nl,
        write("P(H2) = ", N_bez_uluchsh, "/", Vsego, " = ", P_H2, "   (априорная вер. отсутствия улучшения)"), nl, nl,

        /* ------------- шаг 2: условные вероятности признаков ------------- */
        P_E1_H1 = E1_H1 / N_uluchsh,
        P_E2_H1 = E2_H1 / N_uluchsh,
        P_E3_H1 = E3_H1 / N_uluchsh,
        P_E1_H2 = E1_H2 / N_bez_uluchsh,
        P_E2_H2 = E2_H2 / N_bez_uluchsh,
        P_E3_H2 = E3_H2 / N_bez_uluchsh,
        write("P(E1/H1)=", P_E1_H1, "  P(E2/H1)=", P_E2_H1, "  P(E3/H1)=", P_E3_H1), nl,
        write("P(E1/H2)=", P_E1_H2, "  P(E2/H2)=", P_E2_H2, "  P(E3/H2)=", P_E3_H2), nl, nl,

        /* --- шаг 3: формула умножения вероятностей (события независимы) -- */
        P_E_H1 = P_E1_H1 * P_E2_H1 * P_E3_H1,
        P_E_H2 = P_E1_H2 * P_E2_H2 * P_E3_H2,
        write("P(E/H1) = ", P_E1_H1, "*", P_E2_H1, "*", P_E3_H1, " = ", P_E_H1), nl,
        write("P(E/H2) = ", P_E1_H2, "*", P_E2_H2, "*", P_E3_H2, " = ", P_E_H2), nl, nl,

        /* ------------------- шаг 4: формула Байеса ------------------------ */
        Chislitel = P_H1 * P_E_H1,
        Znamenatel = P_H1 * P_E_H1 + P_H2 * P_E_H2,
        P_H1_E = Chislitel / Znamenatel,
        write("P(H1/E) = (P(H1)*P(E/H1)) / (P(H1)*P(E/H1) + P(H2)*P(E/H2))"), nl,
        write("        = (", P_H1, "*", P_E_H1, ") / (", Chislitel, " + ", P_H2, "*", P_E_H2, ")"), nl,
        write("        = ", P_H1_E), nl, nl,

        write("ОТВЕТ: вероятность того, что лекарство приведёт к улучшению = ",
              P_H1_E, " (примерно ", P_H1_E, ")"), nl,
        readchar(_).
