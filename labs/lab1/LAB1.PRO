/* =====================================================================
   ЛАБОРАТОРНАЯ РАБОТА №1.  Вариант 5.
   Тема: основные сведения о языке Пролог и системе Visual Prolog.

   ЗАДАНИЕ (вариант 5):
   Есть факты:
     raspol(Предприятие, Страна)                 - где расположено предприятие
     postav(Поставщик, Покупатель, Товар, Сумма) - кто кому что поставляет

   1) Программа спрашивает СТРАНУ и СУММУ. Выводит список ВСЕХ товаров,
      которые какое-либо предприятие ЭТОЙ страны поставляет за границу,
      если стоимость поставки >= указанной суммы (с указанием
      предприятия-поставщика, предприятия-покупателя и страны-покупателя).
   2) Программа спрашивает ПРЕДПРИЯТИЕ и СУММУ. Если это предприятие
      закупает за границей какой-либо товар на сумму >= указанной -
      сообщить товар, предприятие-поставщика и страну-поставщика.
      Если нет - вывести "нет".

   Как устроен файл (важно для отчёта):
     predicates - объявление всех используемых предикатов (типы аргументов);
     clauses    - сама база фактов + правила обработки;
     goal       - точка входа программы.

   Структуру базы данных (raspol/2, postav/4) НЕ менять - только конкретные
   данные, как требуют "УКАЗАНИЯ" к заданию.
   ===================================================================== */

predicates
    nondeterm raspol(string, string)
    nondeterm postav(string, string, string, integer)

    nondeterm start
    nondeterm obrab_menu(integer)
    nondeterm zadanie1
    nondeterm zadanie2
    nondeterm poisk1(string, integer)
    nondeterm poisk2(string, integer)
    nondeterm naidi_stranu(string, string)   /* предприятие -> его страна */
    nondeterm repeat

goal
    start.

clauses
    /* repeat - НЕ встроенный предикат этого диалекта Пролога! Его нужно
       определить самим (см. методичку, п.1.6.2): первый клоз даёт
       единственную "точку возврата" сразу; второй, рекурсивный, создаёт
       их сколько угодно много при откате. */
    repeat.
    repeat:- repeat.

    /* ---------------- БАЗА ДАННЫХ (пример из методички, лаб.1) ---------- */
    raspol("Оптрон","Россия").
    raspol("Элтор","Польша").
    raspol("Счетмаш","Россия").
    raspol("Кварц","Россия").
    raspol("IBM","США").

    postav("Элтор","Счетмаш","трансформатор",200).
    postav("Счетмаш","Оптрон","осциллограф",500).
    postav("Оптрон","IBM","диод",900).
    postav("Кварц","Элтор","резистор",150).

    /* ---------------- ГЛАВНЫЙ ЦИКЛ (repeat + "Продолжить работу?") ------
       Приём из методички (п.1.6.2): repeat даёт бесконечно много "точек
       возврата". Пока последний вызов в цепочке (здесь - сравнение
       Otvet="нет") ЗАВЕРШАЕТСЯ НЕУДАЧЕЙ, происходит откат к repeat, и
       весь блок выполняется заново (запрашивается новое задание). Как
       только сравнение Otvet="нет" оказывается ИСТИННЫМ, весь клоз start
       УСПЕШНО завершается (без отката) - и работа программы прекращается.
       Важно: НЕЛЬЗЯ ставить fail в конце этого клоза - иначе откат к
       repeat произойдёт всегда, и цикл станет бесконечным. */
    start:-
        repeat,
        nl,
        write("=== Лабораторная работа 1, вариант 5 ==="), nl,
        write("1 - Задание 1 (страна, сумма -> экспортируемые товары)"), nl,
        write("2 - Задание 2 (предприятие, сумма -> что закупает за рубежом)"), nl,
        write("Введите номер задания: "), readint(N),
        obrab_menu(N),
        nl, write("Продолжить работу? (да/нет): "), readln(Otvet),
        Otvet = "нет", !.
    start.

    obrab_menu(1):- zadanie1, !.
    obrab_menu(2):- zadanie2, !.
    obrab_menu(_):- write("Нет такого пункта меню"), nl.

    /* -------------------------- ЗАДАНИЕ 1 -------------------------------
       Спрашиваем страну и минимальную сумму. Ищем ВСЕ поставки, где
       поставщик расположен в этой стране, и сумма поставки не меньше
       заданной. Печатаем: товар, покупатель, страна покупателя.
       Приём "вывести ВСЕ ответы" реализован через fail (см. п.1.6.1):
       после каждого найденного ответа мы искусственно проваливаемся,
       чтобы Пролог поискал СЛЕДУЮЩЕЕ сопоставление с фактами raspol/postav. */
    zadanie1:-
        write("Введите название страны: "), readln(Strana),
        write("Введите минимальную сумму: "), readint(Summa),
        poisk1(Strana, Summa).

    poisk1(Strana, Summa):-
        raspol(Postavshik, Strana),               /* предприятие этой страны */
        postav(Postavshik, Pokupatel, Tovar, S),
        S >= Summa,
        naidi_stranu(Pokupatel, StranaPok),        /* страна покупателя */
        write("Товар: ", Tovar,
              "   Поставщик: ", Postavshik,
              "   Покупатель: ", Pokupatel,
              "   Страна покупателя: ", StranaPok), nl,
        fail.                                       /* искусственный откат, */
    poisk1(_,_).                                     /* чтобы найти все ответы */

    /* -------------------------- ЗАДАНИЕ 2 -------------------------------
       Спрашиваем название предприятия и сумму. Если оно закупает за
       границей (т.е. у предприятия из ДРУГОЙ страны) какой-либо товар на
       сумму >= указанной - выводим товар и поставщика с его страной.
       Если такой сделки нет - выводим "нет" (см. лабораторную работу 1,
       п.1.6.3 "Альтернатива": используем отсечение !, чтобы второй клоз
       poisk2, печатающий "нет", не сработал после успешного ответа). */
    zadanie2:-
        write("Введите название предприятия: "), readln(Predpr),
        write("Введите минимальную сумму: "), readint(Summa),
        poisk2(Predpr, Summa).

    poisk2(Predpr, Summa):-
        raspol(Predpr, StranaPredpr),
        postav(Postavshik, Predpr, Tovar, S),
        S >= Summa,
        naidi_stranu(Postavshik, StranaPostav),
        StranaPostav <> StranaPredpr,               /* именно "за границей" */
        write("Товар: ", Tovar,
              "   Поставщик: ", Postavshik,
              "   Страна поставщика: ", StranaPostav), nl,
        !.                                           /* нашли - хватит одного */
    poisk2(_,_):- write("нет"), nl.

    /* Вспомогательный предикат: по имени предприятия найти его страну */
    naidi_stranu(Predpr, Strana):- raspol(Predpr, Strana), !.
